{
  "opencollection": "1.0.0",
  "info": {
    "name": "ShopMy Partners Catalog Profile API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.shopmy.us/v1/Partners/Profile",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch the authenticated user's public ShopMy profile information. Requires the read_profile scope."
        }
      ]
    }
  ],
  "bundled": true
}