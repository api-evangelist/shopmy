                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"<string>\",\n  \"limit\": 500,\n  \"page\": 0,\n  \"transactionStartDate\": \"<string>\",\n  \"transactionEndDate\": \"<string>\",\n  \"recordUpdatedStartDate\": \"<string>\",\n  \"recordUpdatedEndDate\": \"<string>\",\n  \"reportBySKU\": false,\n  \"source\": \"<string>\"\n}",
