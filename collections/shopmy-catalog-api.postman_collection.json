          "id": "636bf045-e2ea-4de1-b83a-37524d3a0a79",
          "name": "Search Catalog",
          "request": {
            "name": "Search Catalog",
            "description": {
              "content": "Search the ShopMy catalog or resolve a product URL when building a link creation experience. Provide either `search` or `url`, not both. Requires the write_links scope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Catalog",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Query for catalog products (provide this OR url, not both)."
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "Product URL to resolve (provide this OR search, not both)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "Results per page (max 50)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Zero-indexed page number."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
